{
  "description": "Speist erkannte Werbeschablonen nach Textänderungen in den Modellkontext ein.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run_ad_boilerplate_hook.sh\""
          }
        ]
      }
    ]
  }
}
